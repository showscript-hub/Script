box.BorderSizePixel = 0
box.Parent = screenGui

local boxCorner = Instance.new("UICorner")
boxCorner.CornerRadius = UDim.new(0, 12)
boxCorner.Parent = box

--// Circular image
local image = Instance.new("ImageLabel")
image.Name = "DiscordImage"
image.Size = UDim2.fromOffset(72, 72)
image.Position = UDim2.fromOffset(14, 25)
image.BackgroundTransparency = 1
image.Image = IMAGE_ID
image.ScaleType = Enum.ScaleType.Crop
image.Parent = box

local imageCorner = Instance.new("UICorner")
imageCorner.CornerRadius = UDim.new(1, 0)
imageCorner.Parent = image

--// Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -115, 0, 27)
title.Position = UDim2.fromOffset(100, 18)
title.BackgroundTransparency = 1
title.Text = "Updated Script"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 17
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = box

--// Join Discord button
local joinButton = Instance.new("TextButton")
joinButton.Name = "JoinDiscord"
joinButton.Size = UDim2.fromOffset(135, 38)
joinButton.Position = UDim2.fromOffset(100, 55)
joinButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
joinButton.BorderSizePixel = 0
joinButton.Text = "Join Discord"
joinButton.TextColor3 = Color3.fromRGB(88, 101, 242)
joinButton.TextSize = 13
joinButton.Font = Enum.Font.GothamBold
joinButton.Parent = box

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 8)
buttonCorner.Parent = joinButton

--// X close button
local closeButton = Instance.new("TextButton")
closeButton.Name = "Close"
closeButton.Size = UDim2.fromOffset(28, 28)
closeButton.Position = UDim2.new(1, -34, 0, 6)
closeButton.BackgroundTransparency = 1
closeButton.Text = "×"
closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
closeButton.TextSize = 22
closeButton.Font = Enum.Font.GothamBold
closeButton.Parent = box

--// Join Discord
joinButton.MouseButton1Click:Connect(function()
	pcall(function()
		GuiService:OpenBrowserWindow(DISCORD_INVITE)
	end)
end)

--// Close
closeButton.MouseButton1Click:Connect(function()
	screenGui:Destroy()
end)
