

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local DISCORD_INVITE = "https://discord.gg/FJK6QzNnf7"
local IMAGE_ID = "rbxthumb://type=Asset&id=85422381974829&w=420&h=420"

--// ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UpdatedScriptDiscord"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

--// Main box
local box = Instance.new("Frame")
box.Name = "DiscordBox"
box.Size = UDim2.fromOffset(330, 115)
box.Position = UDim2.new(0.5, -165, 0.5, -58)
